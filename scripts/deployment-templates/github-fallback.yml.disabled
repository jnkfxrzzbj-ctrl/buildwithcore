# INACTIVE: activation requires a separately approved PR and environment setup.
name: CORE GitHub fallback (owner gated)
on:
  workflow_dispatch:
    inputs:
      release_sha:
        description: Full reviewed main commit SHA (older main commits allow rollback)
        required: true
        type: string
      fingerprint:
        description: Expected public fingerprint from the reviewed release inventory
        required: true
        type: string
permissions:
  contents: read
concurrency:
  group: core-production-publication
  cancel-in-progress: false
jobs:
  build:
    if: github.ref == 'refs/heads/main' && vars.CORE_GITHUB_FALLBACK_ENABLED == 'approved'
    runs-on: ubuntu-latest
    timeout-minutes: 15
    env:
      CORE_RELEASE_SHA: ${{ inputs.release_sha }}
      CORE_EXPECTED_FINGERPRINT: ${{ inputs.fingerprint }}
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683
        with:
          fetch-depth: 0
          persist-credentials: false
      - name: Require reviewed immutable main history
        shell: bash
        run: |
          set -euo pipefail
          [[ "$CORE_RELEASE_SHA" =~ ^[0-9a-f]{40}$ ]]
          [[ "$CORE_EXPECTED_FINGERPRINT" =~ ^[0-9a-f]{64}$ ]]
          git merge-base --is-ancestor "$CORE_RELEASE_SHA" "$GITHUB_SHA"
          git checkout --detach "$CORE_RELEASE_SHA"
          test "$(git rev-parse HEAD)" = "$CORE_RELEASE_SHA"
          test -z "$(git status --porcelain)"
      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020
        with:
          node-version: '24'
      - name: Check and package approved source
        shell: bash
        run: |
          set -euo pipefail
          node scripts/build.cjs --check
          node scripts/render-performance.cjs --check
          node --test tests/*.test.cjs
          node scripts/package-public.cjs --out "$RUNNER_TEMP/core-public"
          node scripts/verify-public.cjs "$RUNNER_TEMP/core-public" > "$RUNNER_TEMP/inventory.json"
          node -e 'const i=require(process.env.RUNNER_TEMP+"/inventory.json");require("node:assert/strict").equal(i.fingerprint,process.env.CORE_EXPECTED_FINGERPRINT)'
          printf 'Release: %s\nFingerprint: %s\n' "$CORE_RELEASE_SHA" "$CORE_EXPECTED_FINGERPRINT" >> "$GITHUB_STEP_SUMMARY"
      - run: npm install --no-save --package-lock=false playwright@1.62.1
      - run: npx playwright install --with-deps chromium
      - name: Existing package browser acceptance
        env:
          CORE_SITE_ROOT: ${{ runner.temp }}/core-public
        run: node tests/browser-check.cjs
      - uses: actions/upload-pages-artifact@56afc609e74202658d3ffba0e8f6dda462b719fa
        with:
          path: ${{ runner.temp }}/core-public
          retention-days: 14
  deploy:
    needs: build
    runs-on: ubuntu-latest
    timeout-minutes: 15
    permissions:
      pages: write
      id-token: write
    environment:
      name: github-pages
      url: ${{ steps.publish.outputs.page_url }}
    steps:
      - name: Publish the same-run package after owner review
        id: publish
        uses: actions/deploy-pages@d6db90164ac5ed86f2b6aed7e0febac5b3c0c03e
